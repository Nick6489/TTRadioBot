[Unit]
Description=TTRadioBot TeamTalk radio relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ttradiobot %h/.config/ttradiobot/config.toml
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.local/state/ttradiobot

[Install]
WantedBy=default.target
